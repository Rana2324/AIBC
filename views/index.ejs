<div class="container">
  <h1>温度センサー監視システム</h1>

  <!-- Tab Navigation -->
  <div class="tab-container">
    <div class="tab-nav">
      <button class="tab-button" id="sensorTabBtn" onclick="switchTab('sensorTab', this)">
        <span class="tab-icon">📊</span>
        <span>センサー状態</span>
      </button>
      <button class="tab-button" id="serverTabBtn" onclick="switchTab('serverTab', this)">
        <span class="tab-icon">🖥️</span>
        <span>サーバー情報</span>
      </button>
    </div>

    <!-- Sensor Tab Content -->
    <div id="sensorTab" class="tab-content">
      <div class="sensor-panels">
        <% 
          // Group readings by sensor_id
          const sensorGroups = {};
          if (locals.latestReadings && latestReadings.data) {
            latestReadings.data.forEach(reading => {
              if (!sensorGroups[reading.sensorId]) {
                sensorGroups[reading.sensorId] = [];
              }
              sensorGroups[reading.sensorId].push(reading);
            });
          }

          // Define the order of sensors
          const orderedSensorIds = ['sensor_1', 'sensor_2', 'sensor_3'];
          
          // Process sensors in the specified order
          orderedSensorIds.forEach(sensorId => {
            // Check if we have data for this sensor
            if (sensorGroups[sensorId] && sensorGroups[sensorId].length > 0) {
              const readings = sensorGroups[sensorId];
              const latestReading = readings[0]; // Assuming sorted by time
              const statusClass = latestReading.status.includes('正常') ? 'active' : 'alert';
              const statusText = latestReading.status.includes('正常') ? '稼働中' : '異常検出';
        %>
        <!-- Sensor <%= sensorId %> -->
        <div class="sensor-data-section" id="sensor-<%= sensorId %>">
          <div class="sensor-header">
            <h2 class="sensor-title">
              <span class="sensor-icon">🌡️</span>
              <%= sensorId %> センサー情報
            </h2>
            <div class="sensor-status <%= statusClass %>">
              <%= statusText %>
            </div>
          </div>

          <!-- Raw Data History -->
          <div class="sensor-data-section">
            <div class="section-controls">
              <h3>取得データ履歴 <span class="data-count">(最新100件)</span></h3>
              <div class="info-controls">
                <span class="info-timestamp" id="data-last-updated-<%= sensorId %>">最終更新: <%= new Date(latestReading.timestamp).toLocaleTimeString() %></span>
                <button class="info-refresh" onclick="refreshData('<%= sensorId %>')">
                  <span class="material-icons-round">refresh</span>
                </button>
              </div>
            </div>
            <div class="table-wrapper">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>年月日</th>
                    <th>時刻</th>
                    <% for (let i = 1; i <= 16; i++) { %>
                    <th><%= i %></th>
                    <% } %>
                    <th>平均温度</th>
                    <th>状態</th>
                  </tr>
                </thead>
                <tbody id="tbody-<%= sensorId %>">
                  <% readings.forEach(reading => { 
                      // Set rowClass - danger for abnormal status
                      let rowClass = reading.status.includes('正常') ? '' : 'table-danger';
                    %>
                  <tr class="<%= rowClass %>">
                    <td><%= reading.date %></td>
                    <td><%= reading.time %></td>
                    <% if (reading.temperatureData && reading.temperatureData.length > 0) { %>
                    <% reading.temperatureData.forEach(temp => { %>
                    <td><%= temp.toFixed(1) %></td>
                    <% }); %>
                    <% // Fill in missing cells if less than 16 data points
                        for (let i = reading.temperatureData.length; i < 16; i++) { %>
                    <td>--</td>
                    <% } %>
                    <% } else { 
                        // If no temperature data, show 16 empty cells
                        for (let i = 0; i < 16; i++) { %>
                    <td>--</td>
                    <% } 
                      } %>
                    <% 
                      // Check if temperature is out of range (≤ 20°C or ≥ 70°C)
                      const tempOutOfRange = (reading.temperature <= 20 || reading.temperature >= 70);
                    %>
                    <td class="<%= tempOutOfRange ? 'table-danger' : '' %>"><%= reading.temperature.toFixed(1) %> °C</td>
                    <td><%= reading.status.replace('0 ：', '').replace('１：', '') %></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Alert History -->
          <div class="section-header history-section-header">
            <h3>アラート履歴 <span class="data-count">(最新10件)</span></h3>
            <div class="info-controls">
              <span class="info-timestamp" id="alert-last-updated-<%= sensorId %>">最終更新: <%= new Date().toLocaleTimeString() %></span>
              <button class="info-refresh" onclick="refreshAlertData('<%= sensorId %>')">
                <span class="material-icons-round">refresh</span>
              </button>
            </div>
          </div>
          <div class="table-wrapper alert-table">
            <table class="data-table">
              <thead>
                <tr>
                  <th>取得日</th>
                  <th>取得時刻</th>
                  <th>アラート発生理由</th>
                </tr>
              </thead>
              <tbody id="alert-tbody-<%= sensorId %>">
                <% 
                    // Filter alerts for this sensor
                    const sensorAlerts = locals.latestReadings.alerts ? 
                      locals.latestReadings.alerts.filter(alert => alert.sensorId === sensorId) : [];
                    
                    if (sensorAlerts.length > 0) { 
                      sensorAlerts.forEach(alert => { 
                  %>
                <tr class="alert-row">
                  <td><%= alert.date %></td>
                  <td><%= alert.time %></td>
                  <td><%= alert.message %></td>
                </tr>
                <% }); 
                    } else { 
                  %>
                <tr>
                  <td colspan="3" class="text-center">アラートはありません</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Settings History -->
          <div class="section-header history-section-header">
            <h3>設定変更履歴</h3>
            <div class="info-controls">
              <span class="info-timestamp" id="settings-last-updated-<%= sensorId %>">最終更新: <%= new Date().toLocaleTimeString() %></span>
              <button class="info-refresh" onclick="refreshSettingsData('<%= sensorId %>')">
                <span class="material-icons-round">refresh</span>
              </button>
            </div>
          </div>
          <div class="table-wrapper settings-table" id="settings-<%= sensorId %>-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>日付</th>
                  <th>時刻</th>
                  <th>設定内容</th>
                </tr>
              </thead>
              <tbody id="settings-<%= sensorId %>">
                <% if (sensorId === 'sensor_1') { %>
                <tr>
                  <td>2023-10-05</td>
                  <td>15:30:00</td>
                  <td>温度閾値を30°Cに変更</td>
                </tr>
                <tr>
                  <td>2023-10-05</td>
                  <td>14:45:30</td>
                  <td>サンプリング間隔5秒に設定</td>
                </tr>
                <% } else { %>
                <tr>
                  <td colspan="3" class="text-center">設定変更履歴はありません</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Personality History -->
          <div class="section-header history-section-header">
            <h3>個性（バイアス）履歴</h3>
            <div class="info-controls">
              <span class="info-timestamp" id="personality-last-updated-<%= sensorId %>">最終更新: <%= new Date().toLocaleTimeString() %></span>
              <button class="info-refresh" onclick="refreshPersonalityData('<%= sensorId %>')">
                <span class="material-icons-round">refresh</span>
              </button>
            </div>
          </div>
          <div class="table-wrapper personality-table" id="personality-<%= sensorId %>-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>日付</th>
                  <th>時刻</th>
                  <th>バイアス設定</th>
                </tr>
              </thead>
              <tbody id="personality-<%= sensorId %>">
                <% if (sensorId === 'sensor_1') { %>
                <tr>
                  <td>2023-10-05</td>
                  <td>15:00:00</td>
                  <td>+0.5°C 補正を適用</td>
                </tr>
                <% } else { %>
                <tr>
                  <td colspan="3" class="text-center">バイアス設定履歴はありません</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <% } else { 
                // If we don't have data for this sensor, show empty sensor panel
          %>
        <!-- <%= sensorId %> Empty Panel -->
        <div class="sensor-data-section" id="sensor-<%= sensorId %>">
          <div class="sensor-header">
            <h2 class="sensor-title">
              <span class="sensor-icon">🌡️</span>
              <%= sensorId %> センサー情報
            </h2>
            <div class="sensor-status inactive">
              未接続
            </div>
          </div>

          <!-- Empty Data History -->
          <div class="sensor-data-section">
            <div class="section-controls">
              <h3>取得データ履歴 <span class="data-count">(最新100件)</span></h3>
              <div class="info-controls">
                <span class="info-timestamp" id="data-last-updated-<%= sensorId %>">最終更新: --</span>
                <button class="info-refresh" onclick="refreshData('<%= sensorId %>')">
                  <span class="material-icons-round">refresh</span>
                </button>
              </div>
            </div>
            <div class="table-wrapper">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>年月日</th>
                    <th>時刻</th>
                    <% for (let i = 1; i <= 16; i++) { %>
                    <th><%= i %></th>
                    <% } %>
                    <th>平均温度</th>
                    <th>状態</th>
                  </tr>
                </thead>
                <tbody id="tbody-<%= sensorId %>">
                  <tr class="empty-row">
                    <td colspan="20" class="text-center">センサーが未接続のため、データが取得できません。</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Empty Alert History -->
          <div class="section-header history-section-header">
            <h3>アラート履歴 <span class="data-count">(最新10件)</span></h3>
            <div class="info-controls">
              <span class="info-timestamp" id="alert-last-updated-<%= sensorId %>">最終更新: --</span>
              <button class="info-refresh" onclick="refreshAlertData('<%= sensorId %>')">
                <span class="material-icons-round">refresh</span>
              </button>
            </div>
          </div>
          <div class="table-wrapper alert-table">
            <table class="data-table">
              <thead>
                <tr>
                  <th>取得日</th>
                  <th>取得時刻</th>
                  <th>アラート発生理由</th>
                </tr>
              </thead>
              <tbody id="alert-tbody-<%= sensorId %>">
                <tr>
                  <td colspan="3" class="text-center">アラートはありません</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Empty Settings History -->
          <div class="section-header history-section-header">
            <h3>設定変更履歴</h3>
            <div class="info-controls">
              <span class="info-timestamp" id="settings-last-updated-<%= sensorId %>">最終更新: --</span>
              <button class="info-refresh" onclick="refreshSettingsData('<%= sensorId %>')">
                <span class="material-icons-round">refresh</span>
              </button>
            </div>
          </div>
          <div class="table-wrapper settings-table" id="settings-<%= sensorId %>-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>日付</th>
                  <th>時刻</th>
                  <th>設定内容</th>
                </tr>
              </thead>
              <tbody id="settings-<%= sensorId %>">
                <tr>
                  <td colspan="3" class="text-center">設定変更履歴はありません</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Empty Personality History -->
          <div class="section-header history-section-header">
            <h3>個性（バイアス）履歴</h3>
            <div class="info-controls">
              <span class="info-timestamp" id="personality-last-updated-<%= sensorId %>">最終更新: --</span>
              <button class="info-refresh" onclick="refreshPersonalityData('<%= sensorId %>')">
                <span class="material-icons-round">refresh</span>
              </button>
            </div>
          </div>
          <div class="table-wrapper personality-table" id="personality-<%= sensorId %>-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>日付</th>
                  <th>時刻</th>
                  <th>バイアス設定</th>
                </tr>
              </thead>
              <tbody id="personality-<%= sensorId %>">
                <tr>
                  <td colspan="3" class="text-center">バイアス設定履歴はありません</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <% } 
            });
          %>


      </div>
    </div>

    <!-- Server Tab Content -->
    <div id="serverTab" class="tab-content">
      <div class="server-info-container">
        <div class="server-info-header">
          <div>
            <h2 class="server-info-title">
              <span class="server-info-title-icon material-icons-round">dns</span>
              サーバー情報
            </h2>
            <p class="server-info-description">システムの状態、モデル学習の進捗、およびブロックチェーン/IPFSの格納情報</p>
          </div>
        </div>

        <div class="server-info-grid">
          <!-- System Status Card -->
          <div class="info-card">
            <div class="info-card-header">
              <h3 class="info-card-title">
                <span class="info-card-icon material-icons-round">monitor_heart</span>
                システム状態
              </h3>
              <div class="info-controls">
                <span class="info-timestamp">最終更新: <%= new Date().toLocaleTimeString() %></span>
                <button class="info-refresh" onclick="refreshSystemStatus()">
                  <span class="material-icons-round">refresh</span>
                </button>
              </div>
            </div>
            <div class="info-card-content">
              <div class="status-grid">
                <div class="status-item">
                  <p class="status-item-label">MongoDB接続状態</p>
                  <div class="status-item-value">
                    <span class="status-indicator status-connected"></span>
                    <span>接続中</span>
                  </div>
                </div>
                <div class="status-item">
                  <p class="status-item-label">アクティブセンサー</p>
                  <div class="status-item-value">3/5</div>
                </div>
                <div class="status-item">
                  <p class="status-item-label">CPU使用率</p>
                  <div class="status-item-value">23%</div>
                </div>
                <div class="status-item">
                  <p class="status-item-label">メモリ使用率</p>
                  <div class="status-item-value">45%</div>
                </div>
                <div class="status-item">
                  <p class="status-item-label">ディスク使用率</p>
                  <div class="status-item-value">38%</div>
                </div>
                <div class="status-item">
                  <p class="status-item-label">サーバー稼働時間</p>
                  <div class="status-item-value">6時間 28分</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Personality Comparison Card -->
          <div class="info-card">
            <div class="info-card-header">
              <h3 class="info-card-title">
                <span class="info-card-icon material-icons-round">psychology</span>
                個性比較履歴
              </h3>
              <div class="info-controls">
                <span class="info-timestamp">最終更新: <%= new Date().toLocaleTimeString() %></span>
                <button class="info-refresh" onclick="refreshPersonalityComparisonData()">
                  <span class="material-icons-round">refresh</span>
                </button>
              </div>
            </div>
            <div class="info-card-content">
              <div class="table-container">
                <table class="info-table">
                  <thead>
                    <tr>
                      <th>日付</th>
                      <th>時刻</th>
                      <th>センサーID</th>
                      <th>差異値</th>
                      <th>評価</th>
                      <th>特徴パターン</th>
                      <th>変動傾向</th>
                    </tr>
                  </thead>
                  <tbody id="personality-comparison-tbody">
                    <tr>
                      <td>2025-04-07</td>
                      <td>10:25:30</td>
                      <td>sensor_1</td>
                      <td>0.85</td>
                      <td>通常範囲内の個性</td>
                      <td>規則的変動</td>
                      <td>安定</td>
                    </tr>
                    <tr>
                      <td>2025-04-07</td>
                      <td>09:15:22</td>
                      <td>sensor_2</td>
                      <td>1.75</td>
                      <td>注意: 高い個性</td>
                      <td>不規則変動</td>
                      <td>上昇傾向</td>
                    </tr>
                    <tr>
                      <td>2025-04-06</td>
                      <td>18:45:12</td>
                      <td>sensor_3</td>
                      <td>1.25</td>
                      <td>通常範囲内の個性</td>
                      <td>周期的変動</td>
                      <td>緩やかな上昇</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Blockchain/IPFS Storage Card -->
          <div class="info-card">
            <div class="info-card-header">
              <h3 class="info-card-title">
                <span class="info-card-icon material-icons-round">storage</span>
                ブロックチェーン/IPFS格納履歴
              </h3>
              <div class="info-controls">
                <span class="info-timestamp">最終更新: <%= new Date().toLocaleTimeString() %></span>
                <button class="info-refresh" onclick="refreshBlockchainData()">
                  <span class="material-icons-round">refresh</span>
                </button>
              </div>
            </div>
            <div class="info-card-content">
              <div class="table-container">
                <table class="info-table">
                  <thead>
                    <tr>
                      <th>日付</th>
                      <th>時刻</th>
                      <th>モデルID</th>
                      <th>センサーID</th>
                      <th>IPFS CID</th>
                      <th>ブロックチェーンTX</th>
                      <th>ステータス</th>
                    </tr>
                  </thead>
                  <tbody id="blockchain-ipfs-tbody">
                    <tr>
                      <td>2025-04-07</td>
                      <td>11:05:35</td>
                      <td>model_001</td>
                      <td>sensor_1</td>
                      <td>QmABC123...</td>
                      <td>0xDef456...</td>
                      <td class="status-completed">完了</td>
                    </tr>
                    <tr>
                      <td>2025-04-07</td>
                      <td>10:30:22</td>
                      <td>model_002</td>
                      <td>sensor_2</td>
                      <td>QmDEF456...</td>
                      <td>0xGhi789...</td>
                      <td class="status-pending">処理中</td>
                    </tr>
                    <tr>
                      <td>2025-04-06</td>
                      <td>19:25:12</td>
                      <td>model_003</td>
                      <td>sensor_3</td>
                      <td>QmGHI789...</td>
                      <td>0xJkl012...</td>
                      <td class="status-completed">完了</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Model Training Card -->
          <div class="info-card">
            <div class="info-card-header">
              <h3 class="info-card-title">
                <span class="info-card-icon material-icons-round">model_training</span>
                標準モデルをデータで教育してアップデート
              </h3>
              <div class="info-controls">
                <span class="info-timestamp">最終更新: <%= new Date().toLocaleTimeString() %></span>
                <button class="info-refresh" onclick="refreshModelTrainingData()">
                  <span class="material-icons-round">refresh</span>
                </button>
              </div>
            </div>
            <div class="info-card-content">


              <div class="status-grid">
                <div class="status-item">
                  <p class="status-item-label">データポイント</p>
                  <div class="status-item-value">12,458</div>
                </div>
                <div class="status-item">
                  <p class="status-item-label">学習エポック</p>
                  <div class="status-item-value">35/50</div>
                </div>
                <div class="status-item">
                  <p class="status-item-label">推定残り時間</p>
                  <div class="status-item-value">00:15:32</div>
                </div>
                <div class="status-item">
                  <p class="status-item-label">モデル精度</p>
                  <div class="status-item-value">94.8%</div>
                </div>
              </div>

              <div class="table-container">
                <table class="info-table">
                  <thead>
                    <tr>
                      <th>日付</th>
                      <th>バージョン</th>
                      <th>精度</th>
                      <th>損失</th>
                      <th>データポイント</th>
                      <th>所要時間</th>
                    </tr>
                  </thead>
                  <tbody id="model-training-tbody">
                    <tr>
                      <td>2025-04-06</td>
                      <td>v1.2.5</td>
                      <td>93.5%</td>
                      <td>0.12</td>
                      <td>10,234</td>
                      <td>01:25:13</td>
                    </tr>
                    <tr>
                      <td>2025-04-04</td>
                      <td>v1.2.4</td>
                      <td>92.8%</td>
                      <td>0.15</td>
                      <td>9,845</td>
                      <td>01:20:45</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- JavaScript -->
<script src="/js/index.js"></script>